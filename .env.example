# Cloud sync (OneDrive / Google Drive) OAuth configuration.
# See the "Cloud Sync Setup" section in README.md for how to obtain these.
# All values here are client-side (NEXT_PUBLIC_*) — there are no secrets:
# this is a static-export SPA with no server, so auth uses public client
# IDs only, never a client secret.

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application). Leave unset to disable the Google Drive option.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Azure Portal > App registrations > (your app) > Application (client) ID
# (platform: Single-page application). Leave unset to disable the OneDrive
# option.
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=

# Azure AD tenant to authenticate against. "common" (the default) allows
# both personal Microsoft accounts and any work/school account.
NEXT_PUBLIC_MICROSOFT_TENANT_ID=common
