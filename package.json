    "@mui/x-date-pickers": "^8.5.3",
    "@types/papaparse": "^5.3.16",
    "@types/sql.js": "^1.4.9",
    "@types/uuid": "^10.0.0",
    "buffer": "^6.0.3",
    "date-fns": "^4.1.0",
    "next": "15.3.4",
    "next-auth": "^4.24.11",
